---
// definición de constantes
import Social from "./Social.astro";
---

<style>
  footer {
    display: flex;
    gap: 1rem; /* separación entre cada elemento hijo dentro del footer */
    margin-top: 1rem; /* sirve para empujar toda la caja del footer 1rem hacia abajo, creando un espacio vacio entre el último parrafo y el footer. */
    align-items: center; /*Le dice a Flexbox: "No estires los botones, deja que cada botón mida solo lo que mide su texto mas su pagging, alineados al centro verticalmente." */
  }
</style>

<footer>
  <p>Sigueme en mis redes sociales:</p>
  <Social platform="twitter" username="astrodotbuild" />
  <Social platform="github" username="withastro" />
  <Social platform="youtube" username="astrodotbuild" />
</footer>
