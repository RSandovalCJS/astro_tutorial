---
// ESTE ESPACIO SE LLAMA FRONTMATTER. AQUÍ PODEMOS DEFINIR VARIABLES, CONSTANTES, IMPORTAR COMPONENTES ASTRO, PLANTILLAS CSS

//importanción de componentes astro
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

// importación de estillos .css
import "../styles/global.css";

// declaración de constantes / variables
const pageTitle = "Sobre Mi";

const identity = {
  firstname: "Rodrigo",
  country: "Chile",
  occupation: "Escritor técnico",
  hobbies: ["fotografía", "observación de aves", "Universidad de Chile"],
};

const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Node.js"];

// constantes de prueba para renderización condicional de elementos
const happy = true;
const finished = false;
const goal = 3;

// definición de variable css
const skillColor = "crimson";
const fontWeight = "lighter";
const textCase = "uppercase";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro</title>
  </head>

  <body>
    <Header />

    <h1>{pageTitle}</h1>
    <!-- definimos la variable css que contendrá el valor de la variable JS SkillColor del frontmmatter -->
    <style define:vars={{ skillColor, fontWeight, textCase }}>
      h1 {
        color: purple;
        font-size: 4rem;
      }
      .skill {
        color: var(--skillColor);
        font-weight: var(--fontWeight);
        text-transform: var(--textCase);
      }
    </style>

    <h2>
      Hola! Soy Rodrigo y ese sitio blog lo creé siguiendo el tutorial Astro!
    </h2>

    <p>
      Estoy trabajando en el tutorial introductorio de Astro. Esta es la segunda
      página de mi sitio web. ¡y es la primera que he construido usando Astro!
    </p>

    <p>
      Este sitio se irá actualizando a medida que vaya completando más partes
      del tutorial, ¡asi que no dejes de visitarlo para ver cómo va mi viaje!
    </p>

    <p>He aquí algunos datos sobre mi:</p>
    <ul>
      <li>Me llamo {identity.firstname}.</li>
      <li>
        Vivo en {identity.country} y trabajando como {identity.occupation}.
      </li>
      {
        identity.hobbies.length >= 2 && (
          <li>
            Dos de mis aficiones son: {identity.hobbies[0]} y{" "}
            {identity.hobbies[1]}
          </li>
        )
      }
      <p>Mis habilidades son:</p>
      <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
      </ul>
    </ul>

    {happy && <p>¡Estoy feliz de aprender Astro!</p>}
    {finished && <p>¡He terminado este tutorial!</p>}
    {
      goal === 3 ? (
        <p>Mi objetivo es terminar en 3 días</p>
      ) : (
        <p>Mi objetivo no son 3 días</p>
      )
    }

    <Footer />

    <script>
      import "../scripts/menu.js";
    </script>
  </body>
</html>
