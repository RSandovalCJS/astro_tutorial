---
// ESTE ESPACIO SE LLAMA FRONTMATTER. AQUÍ PODEMOS DEFINIR VARIABLES, CONSTANTES, IMPORTAR COMPONENTES ASTRO, PLANTILLAS CSS

//importanción de componentes astro
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";

// importación de estillos .css
import "../styles/global.css";

